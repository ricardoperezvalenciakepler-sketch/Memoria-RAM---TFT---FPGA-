                    when 5 => g := "10001";
                    when others => g := "11110";
                end case;

            when 'F' =>
                case r is
                    when 0 => g := "11111";
                    when 1 => g := "10000";
                    when 2 => g := "10000";
                    when 3 => g := "11110";
                    when 4 => g := "10000";
                    when 5 => g := "10000";
                    when others => g := "10000";
