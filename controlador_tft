    -- SELECCION COMANDO / DATO
    function init_dc(i : integer) return STD_LOGIC is
    begin
        if i = 0 or i = 1 or i = 2 or i = 6 or i = 10 or
           i = 17 or i = 19 or i = 23 or i = 25 or i = 28 or
           i = 31 or i = 34 or i = 36 or i = 37 or i = 39 or
           i = 41 or i = 42 or i = 43 or i = 48 or i = 53 then
            return '0';
        else
            return '1';
        end if;
    end function;


    -- DIRECCION DE PANTALLA
    function render_byte(i : integer) return STD_LOGIC_VECTOR is
    begin
        case i is
            when 0 => return x"2A";
            when 1 =>
                return std_logic_vector(to_unsigned((X_OFFSET / 256) mod 256, 8));
            when 2 =>
                return std_logic_vector(to_unsigned(X_OFFSET mod 256, 8));
            when 3 =>
                return std_logic_vector(to_unsigned(((127 + X_OFFSET) / 256) mod 256, 8));
            when 4 =>
                return std_logic_vector(to_unsigned((127 + X_OFFSET) mod 256, 8));
            when 5 => return x"2B";
            when 6 =>
                return std_logic_vector(to_unsigned((Y_OFFSET / 256) mod 256, 8));
            when 7 =>
                return std_logic_vector(to_unsigned(Y_OFFSET mod 256, 8));
            when 8 =>
                return std_logic_vector(to_unsigned(((159 + Y_OFFSET) / 256) mod 256, 8));
            when 9 =>
                return std_logic_vector(to_unsigned((159 + Y_OFFSET) mod 256, 8));
            when others => return x"2C";
        end case;
    end function;


    function render_dc(i : integer) return STD_LOGIC is
    begin
        if i = 0 or i = 5 or i = 10 then
            return '0';
        else
            return '1';
        end if;
    end function;


    function bit_char(b : STD_LOGIC) return character is
    begin
        if b = '1' then
            return '1';
        else
            return '0';
        end if;
    end function;


    function line_length(line_no : integer) return integer is
    begin
        case line_no is
            when 0 => return 11;
            when 1 => return 9;
            when 2 => return 10;
            when others => return 0;
        end case;
    end function;


    function line_char(
        line_no : integer;
        pos     : integer;
        addr    : STD_LOGIC_VECTOR(1 downto 0);
        data    : STD_LOGIC_VECTOR(3 downto 0)
    ) return character is
    begin
        case line_no is
            when 0 =>
                case pos is
                    when 0 => return 'M';
                    when 1 => return 'E';
                    when 2 => return 'M';
                    when 3 => return 'O';
                    when 4 => return 'R';
                    when 5 => return 'I';
                    when 6 => return 'A';
                    when 7 => return ' ';
                    when 8 => return 'R';
                    when 9 => return 'A';
                    when others => return 'M';
                end case;

            when 1 =>
                case pos is
                    when 0 => return 'D';
                    when 1 => return 'I';
                    when 2 => return 'R';
                    when 3 => return 'E';
                    when 4 => return 'C';
                    when 5 => return 'C';
                    when 6 => return 'I';
                    when 7 => return 'O';
                    when others => return 'N';
                end case;

            when 2 =>
                case pos is
                    when 0 => return 'D';
                    when 1 => return 'A';
                    when 2 => return 'T';
                    when 3 => return 'O';
                    when 4 => return ':';
                    when 5 => return ' ';
                    when 6 => return bit_char(not data(3));
                    when 7 => return bit_char(not data(2));
                    when 8 => return bit_char(not data(1));
                    when others => return bit_char(not data(0));
                end case;

            when others => return ' ';
        end case;
    end function;


    -- FUENTE DE LETRAS 5x7
    function glyph_row(
        c : character;
        r : integer
