        variable g : STD_LOGIC_VECTOR(4 downto 0) := "00000";

    begin

        if r < 0 or r > 6 then
            return g;
        end if;

        case c is

            when 'A' =>
                case r is
                    when 0 => g := "01110";
                    when 1 => g := "10001";
                    when 2 => g := "10001";
                    when 3 => g := "11111";
                    when 4 => g := "10001";
                    when 5 => g := "10001";
                    when others => g := "10001";
