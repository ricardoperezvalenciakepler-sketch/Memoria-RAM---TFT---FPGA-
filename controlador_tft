	     -- DETECCION DE PIXEL DE TEXTO
    function text_hit(
        line_no : integer;
        x       : integer;
        y       : integer;
        x0      : integer;
        y0      : integer;
        addr    : STD_LOGIC_VECTOR(1 downto 0);
        data    : STD_LOGIC_VECTOR(3 downto 0)
    ) return boolean is

        variable px : integer;
        variable py : integer;
        variable pos : integer;
        variable col : integer;
        variable ch : character;
        variable row_bits : STD_LOGIC_VECTOR(4 downto 0);

    begin

        px := x - x0;
        py := y - y0;

        if px < 0 or py < 0 or py > 6 then
            return false;
        end if;

        pos := px / 6;
        col := px mod 6;

        if pos >= line_length(line_no) or col > 4 then
            return false;
        end if;

        ch := line_char(line_no, pos, addr, data);
        row_bits := glyph_row(ch, py);

        if row_bits(4-col) = '1' then
            return true;
        else
            return false;
        end if;

    end function;


    function glyph_hit(
        c : character;
        x : integer;
        y : integer;
        x0 : integer;
        y0 : integer
    ) return boolean is

        variable px : integer;
        variable py : integer;
        variable row_bits : STD_LOGIC_VECTOR(4 downto 0);

    begin

        px := x - x0;
        py := y - y0;

        if px < 0 or px > 4 or py < 0 or py > 6 then
            return false;
        end if;

        row_bits := glyph_row(c, py);

        return row_bits(4-px) = '1';

    end function;


    -- LOGOTIPO UPN EN BITMAP MONOCROMATICO 42 x 26
    function logo_row(y : integer) return STD_LOGIC_VECTOR is
    begin
        case y is
            when 0 => return "000000111011100000000011011101111100110011";
            when 1 => return "000001111011110000000011011101111100110011";
            when 2 => return "000011111011111000000011011101101110111011";
            when 3 => return "000011111011111000000011011101101110111011";
            when 4 => return "000111111011111100000011011101101110111111";
            when 5 => return "001111111011111110000011011101111110111111";
            when 6 => return "111111111011111111100011011101111100111111";
            when 7 => return "111111111011111111100011011101111000110111";
            when 8 => return "111101111011110111100011011101100000110111";
            when 9 => return "111001111011110001100011111001100000110111";
            when 10 => return "100001111011110000100011111001100000110011";
            when 11 => return "000001111011110000000000000000000000000000";
            when 12 => return "000001111011110000000000000000000000000000";
            when 13 => return "000001111011110000000000000000000000000000";
            when 14 => return "000001111011110000000011101101011111101010";
            when 15 => return "000001111011110000000011110111011101111110";
            when 16 => return "000001111011110000000011111011111111111110";
            when 17 => return "000001111011110000000000000000000000000000";
            when 18 => return "000001111011110000000000000000000000000000";
            when 19 => return "000001111011110000000011111111111100000000";
            when 20 => return "000001111011110000000010110111111100000000";
            when 21 => return "000001111011110000000000000000000000000000";
            when 22 => return "000001111011110000000000000000000000000000";
            when 23 => return "000001111011110000000011110011111111000000";
            when 24 => return "000001111011110000000011110011111101000000";
            when 25 => return "000001111011110000000011111011111101000000";
            when others => return (others => '0');
        end case;
    end function;


    -- GENERACION DE COLOR RGB565
    function pixel_color(
        x : integer;
        y : integer;
        addr : STD_LOGIC_VECTOR(1 downto 0);
        data : STD_LOGIC_VECTOR(3 downto 0)
    ) return STD_LOGIC_VECTOR is

        variable result_color : STD_LOGIC_VECTOR(15 downto 0);
        variable box_x        : integer;
        variable label_x      : integer;
        variable bit_index    : integer;
        variable logo_bits    : STD_LOGIC_VECTOR(41 downto 0);
        variable digit_char   : character;

    begin

        -- FONDO ROSADO CLARO
        result_color := x"F79E";

        ------------------------------------------------
        -- LOGO UPN: ESQUINA SUPERIOR DERECHA
        ------------------------------------------------
        if x >= 82 and x < 100 and y >= 5 and y < 31 then
            logo_bits := logo_row(y - 5);
            if logo_bits(41 - (x - 82)) = '1' then
                result_color := x"0000";
            end if;
        end if;

        -- TEXTO UPN EN NEGRO, IGUAL QUE EL SIMBOLO
        if glyph_hit('U', x, y, 103, 14) or
           glyph_hit('P', x, y, 109, 14) or
           glyph_hit('N', x, y, 115, 14) then
            result_color := x"0000";
        end if;

        ------------------------------------------------
        -- TITULO, DIRECCION Y DATO
        ------------------------------------------------
        if text_hit(0, x, y, 31, 37, addr, data) then
            result_color := x"000F";
        elsif text_hit(1, x, y, 4, 58, addr, data) then
            result_color := x"000F";
        elsif text_hit(2, x, y, 29, 75, addr, data) then
            result_color := x"000F";
        end if;

        ------------------------------------------------
        -- INDICADORES DE DIRECCION
        ------------------------------------------------
        for i in 0 to 1 loop
            box_x := 76 + (i * 14);

            if x >= box_x and x < box_x + 9 and
               y >= 56 and y < 66 then

                if x = box_x or x = box_x + 8 or
                   y = 56 or y = 65 then
                    result_color := x"000F";
                elsif addr(1-i) = '1' then
                    result_color := x"001F";
                else
                    result_color := x"0000";
                end if;
            end if;
        end loop;

        ------------------------------------------------
        -- ETIQUETAS D3, D2, D1, D0
        ------------------------------------------------
        for i in 0 to 3 loop
            label_x := 8 + (i * 30);

            case i is
                when 0 => digit_char := '3';
                when 1 => digit_char := '2';
                when 2 => digit_char := '1';
                when others => digit_char := '0';
            end case;

            if glyph_hit('D', x, y, label_x, 101) or
               glyph_hit(digit_char, x, y, label_x + 6, 101) then
                result_color := x"000F";
            end if;
        end loop;

        ------------------------------------------------
        -- CUADRITOS DE LOS CUATRO BITS
        ------------------------------------------------
        for i in 0 to 3 loop
            box_x := 8 + (i * 30);
            bit_index := 3 - i;

            if x >= box_x and x < box_x + 14 and
               y >= 123 and y < 137 then

                if x = box_x or x = box_x + 13 or
                   y = 123 or y = 136 then
                    result_color := x"000F";

                -- SWITCH EN 0: CUADRITO AZUL
                elsif data(bit_index) = '0' then
                    result_color := x"001F";

                -- SWITCH EN 1: CUADRITO NEGRO
                else
                    result_color := x"0000";
                end if;
            end if;
        end loop;

        return result_color;

    end function;

begin

    -- MODULO SPI
    U_SPI: entity work.spi_master
        generic map (
            DIVIDER => SPI_DIV
        )
        port map (
            CLK     => CLK,
            RESET_N => '1',
            START   => tx_start,
            DATA_IN => tx_data,
            MOSI    => tx_mosi,
            SCK     => tx_sck,
            BUSY    => tx_busy,
            DONE    => tx_done
        );

    TFT_SCK <= tx_sck;
    TFT_SDA <= tx_mosi;
    TFT_A0  <= tx_dc;

    TFT_CS <= '0';


    -- MAQUINA DE ESTADOS TFT
    process(CLK)

        variable pix : STD_LOGIC_VECTOR(15 downto 0);

    begin

        if rising_edge(CLK) then

            tx_start <= '0';

            case state is

                -- RESET DE PANTALLA
                when RESET_LOW =>

                    TFT_RESET <= '0';

                    if delay_count >= (CLK_HZ / 100) then
                        delay_count <= 0;
                        TFT_RESET <= '1';
                        state <= RESET_HIGH;
                    else
                        delay_count <= delay_count + 1;
                    end if;


                when RESET_HIGH =>

                    TFT_RESET <= '1';

                    if delay_count >= (CLK_HZ / 100) then
                        delay_count <= 0;
                        init_index <= 0;
                        launched <= '0';
                        state <= INIT_SEND;
                    else
                        delay_count <= delay_count + 1;
                    end if;


                -- ENVIO DE COMANDOS DE INICIALIZACION
                when INIT_SEND =>

                    if launched = '0' then
                        tx_data <= init_byte(init_index);
                        tx_dc <= init_dc(init_index);
                        tx_start <= '1';
                        launched <= '1';

                    elsif tx_done = '1' then

                        launched <= '0';

                        if init_index = 0 then
                            delay_count <= 7500000;
                            state <= INIT_WAIT;

                        elsif init_index = 1 then
                            delay_count <= 6000000;
                            state <= INIT_WAIT;

                        elsif init_index = 53 then
                            state <= RENDER_SETUP;

                        else
                            init_index <= init_index + 1;
                        end if;
                    end if;


                -- ESPERAS DE INICIALIZACION
                when INIT_WAIT =>

                    if delay_count = 0 then
                        init_index <= init_index + 1;
                        state <= INIT_SEND;
                    else
                        delay_count <= delay_count - 1;
                    end if;


                -- PREPARACION DE DIBUJO
                when RENDER_SETUP =>

                    render_index <= 0;
                    launched <= '0';
                    state <= RENDER_SEND;


                -- CONFIGURACION DE AREA DE PANTALLA
                when RENDER_SEND =>

                    if launched = '0' then
                        tx_data <= render_byte(render_index);
                        tx_dc <= render_dc(render_index);
                        tx_start <= '1';
                        launched <= '1';

                    elsif tx_done = '1' then

                        launched <= '0';

                        if render_index = 10 then
                            x_count <= 0;
                            y_count <= 0;
                            state <= PIXEL_HIGH;
                        else
                            render_index <= render_index + 1;
                        end if;
                    end if;


                -- ENVIO DEL BYTE ALTO DEL PIXEL
                when PIXEL_HIGH =>

                    if launched = '0' then

                        pix := pixel_color(
                            x_count,
                            y_count,
                            ADDR_VIEW,
                            DATA_VIEW
                        );

                        tx_data <= pix(15 downto 8);
                        tx_dc <= '1';
                        tx_start <= '1';
                        launched <= '1';

                    elsif tx_done = '1' then
                        launched <= '0';
                        state <= PIXEL_LOW;
                    end if;


                -- ENVIO DEL BYTE BAJO DEL PIXEL
                when PIXEL_LOW =>

                    if launched = '0' then

                        pix := pixel_color(
                            x_count,
                            y_count,
                            ADDR_VIEW,
                            DATA_VIEW
                        );

                        tx_data <= pix(7 downto 0);
                        tx_dc <= '1';
                        tx_start <= '1';
                        launched <= '1';

                    elsif tx_done = '1' then

                        launched <= '0';

                        if x_count = 127 and y_count = 159 then
                            state <= IDLE;
                        else

                            if x_count = 127 then
                                x_count <= 0;
                                y_count <= y_count + 1;
                            else
                                x_count <= x_count + 1;
                            end if;

                            state <= PIXEL_HIGH;
                        end if;
                    end if;


                -- ESPERA HASTA BTN_MOSTRAR
                when IDLE =>

                    TFT_RESET <= '1';

                    if REFRESH = '1' then
                        state <= RENDER_SETUP;
                    end if;


                when others =>
                    state <= RESET_LOW;

            end case;

        end if;

    end process;

end Behavioral;
