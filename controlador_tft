library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity controlador_tft is
    generic (
        CLK_HZ    : positive := 50000000;
        SPI_DIV   : positive := 4;
        X_OFFSET  : natural := 0;
        Y_OFFSET  : natural := 0
    );
    port (
        CLK       : in  STD_LOGIC;
        REFRESH   : in  STD_LOGIC;
        ADDR_VIEW : in  STD_LOGIC_VECTOR(1 downto 0);
        DATA_VIEW : in  STD_LOGIC_VECTOR(3 downto 0);

        TFT_SCK   : out STD_LOGIC;
        TFT_SDA   : out STD_LOGIC;
        TFT_A0    : out STD_LOGIC;
        TFT_RESET : out STD_LOGIC;
        TFT_CS    : out STD_LOGIC
    );
end controlador_tft;

architecture Behavioral of controlador_tft is

    type state_type is (
        RESET_LOW,
        RESET_HIGH,
        INIT_SEND,
        INIT_WAIT,
        RENDER_SETUP,
        RENDER_SEND,
        PIXEL_HIGH,
        PIXEL_LOW,
        IDLE
    );

    signal state : state_type := RESET_LOW;

    signal tx_start : STD_LOGIC := '0';
    signal tx_data  : STD_LOGIC_VECTOR(7 downto 0) := (others => '0');

    signal tx_mosi : STD_LOGIC;
    signal tx_sck  : STD_LOGIC;
    signal tx_busy : STD_LOGIC;
    signal tx_done : STD_LOGIC;

    signal tx_dc    : STD_LOGIC := '0';
    signal launched : STD_LOGIC := '0';

    signal init_index   : integer range 0 to 53 := 0;
    signal render_index : integer range 0 to 10 := 0;

    signal delay_count : integer range 0 to 7500000 := 0;

    signal x_count : integer range 0 to 127 := 0;
    signal y_count : integer range 0 to 159 := 0;


